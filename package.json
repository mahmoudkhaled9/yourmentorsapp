{
  "name": "mentors-crm-server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "backend:status": "bash scripts/backend-process.sh status",
    "backend:restart": "bash scripts/backend-process.sh restart",
    "dev:demo": "node test/support/dev-server.js --demo --port 4011",
    "gen-secret": "node scripts/gen-secret.mjs",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test --test-concurrency=4 test/unit/*.test.js test/integration/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=4 test/integration/*.test.js",
    "test:api": "node --test --test-concurrency=4 test/integration/*.test.js",
    "test:canonical": "node scripts/run-with-env.mjs TEST_SCHEMA=canonical -- node --test --test-concurrency=4 test/integration/*.test.js",
    "test:mysql": "node scripts/test-mysql.mjs",
    "test:e2e": "npm --prefix ../mentorsfront run test:e2e",
    "test:all": "npm run check && npm run test:unit && npm run test:integration && npm run test:canonical",
    "verify": "npm run test:all",
    "smoke": "node scripts/smoke-test.mjs",
    "seed:dev": "node scripts/seed-dev-data.mjs",
    "db:audit": "node scripts/db-audit.mjs",
    "qa:prepare": "node scripts/qa-mysql-prepare.mjs",
    "backup": "node scripts/export-backup.mjs",
    "backup:portable": "node scripts/export-backup.mjs --portable",
    "restore": "node scripts/restore-backup.mjs",
    "fix:developer-logos": "node scripts/fix-developer-logos.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}
