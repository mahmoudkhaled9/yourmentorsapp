# QA accounts for `npm run test:mysql`. Copy to .env.test (never commit it) and fill in the passwords you chose in
# scripts/qa-mysql-setup.sql. The production settings (DB_*) stay in .env and are only used for read-only row counts.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
# creates / drops mentors_crm_test_<timestamp> only; never passed to the test process
TEST_DB_ADMIN_USER=mentors_qa_admin
TEST_DB_ADMIN_PASSWORD=
# the only account the tests receive; privileges on mentors_crm_test_% only
TEST_DB_USER=mentors_qa
TEST_DB_PASSWORD=
