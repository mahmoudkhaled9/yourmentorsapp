# Copy to .env and fill in. Never commit .env.
# --- database (MySQL 8+) -----------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mentors_user
DB_PASSWORD=
# The database must exist (CREATE DATABASE mentors_crm CHARACTER SET utf8mb4;). Tables are created/upgraded on start.
DB_NAME=mentors_crm
# DB_POOL_SIZE=15
# DB_QUEUE_LIMIT=300

# --- server -------------------------------------------------------------------------------------------------
PORT=4001
NODE_ENV=development
# REQUIRED. Generate with: npm run gen-secret -- --write   (the server refuses to start with an empty or template value)
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated list of frontend origins allowed to call the API from a browser.
CORS_ORIGIN=http://localhost:5173
# Set when running behind nginx / a load balancer (number of proxies), so rate limits see the real client IP.
# TRUST_PROXY=1

# --- first start on an EMPTY database only ------------------------------------------------------------------
# INITIAL_ADMIN_EMAIL=admin@mentors.com
# INITIAL_ADMIN_PASSWORD=   (leave empty to have a random one generated and printed once)

# --- tests against a real MySQL (npm run test:mysql) - a fresh *_test database is created per run -------------
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=3306
# TEST_DB_USER=root
# TEST_DB_PASSWORD=
