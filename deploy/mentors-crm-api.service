# systemd unit for the API (Linux server). Install:
#   sudo cp deploy/mentors-crm-api.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now mentors-crm-api        logs: journalctl -u mentors-crm-api -f
# <...> values are deployment requirements: adjust the user and paths to the real server.
[Unit]
Description=Your Mentor CRM API
After=network-online.target mysql.service
Wants=network-online.target
# stop retrying after 10 failed starts in 5 minutes (a broken configuration should not restart forever)
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=<service-user>
WorkingDirectory=/opt/mentors-crm/yourmentorsapp
# .env in the working directory holds the production settings (see .env.production.example); readable by this user only
Environment=NODE_ENV=production
ExecStartPre=/usr/bin/node scripts/preflight.mjs
ExecStart=/usr/bin/node src/index.js
# graceful shutdown: the server stops accepting, finishes requests and closes the pool on SIGTERM
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=5
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# the API writes nothing to disk: logs go to stdout (journald)

[Install]
WantedBy=multi-user.target
