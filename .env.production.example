# PRODUCTION settings template. Copy to the server as .env (never commit the filled-in file).
# Every <...> is a DEPLOYMENT REQUIREMENT that is not decided yet: the server refuses to start with a missing/weak
# JWT_SECRET, and browsers are blocked until CORS_ORIGIN names the real frontend address.
NODE_ENV=production
PORT=4001

# A dedicated production database and account (NOT the development mentors_crm data, NOT root).
# The account needs privileges on this one database only: GRANT ALL ON `<prod-db>`.* TO '<prod-user>'@'<app-host>';
DB_HOST=<production-mysql-host>
DB_PORT=3306
DB_USER=<production-db-user>
DB_PASSWORD=<production-db-password>
DB_NAME=<production-db-name>

# New random secret for production (npm run gen-secret). Never reuse the development value.
JWT_SECRET=<generate-with-npm-run-gen-secret>
JWT_EXPIRES_IN=7d

# The HTTPS address the frontend is served from, e.g. https://crm.<your-domain> (comma-separated if several).
CORS_ORIGIN=<https://frontend-origin>

# Only when a reverse proxy / load balancer (nginx, Apache, Hostinger proxy, ...) is in front of Node: the number of
# proxies. Leave unset when Node is reached directly, otherwise clients could spoof their IP for the rate limits.
# TRUST_PROXY=1

# First start on an EMPTY production database: the first administrator (password: leave empty to have a random one
# printed once, then change it at first sign-in).
INITIAL_ADMIN_EMAIL=<first-admin-email>
INITIAL_ADMIN_PASSWORD=
